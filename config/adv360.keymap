#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/modifiers.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/stp.h>
#include <dt-bindings/zmk/backlight.h>
#define ZMK_POINTING_DEFAULT_MOVE_VAL 1800
#define ZMK_POINTING_DEFAULT_SCRL_VAL 30
#include <dt-bindings/zmk/pointing.h>

&mmv {
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <1>;
};

&msc {
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <1>;
};

/ {
    behaviors {
      #include "macros.dtsi"
      #include "version.dtsi"

      hm: homerow_mods {
          compatible = "zmk,behavior-hold-tap";
          label = "HOMEROW_MODS";
          #binding-cells = <2>;
          tapping-term-ms = <200>;
          quick_tap_ms = <175>;
          flavor = "tap-preferred";
          bindings = <&kp>, <&kp>;
      };

      f_mouse: f_mouse {
          compatible = "zmk,behavior-hold-tap";
          label = "F_MOUSE";
          #binding-cells = <2>;
          tapping-term-ms = <175>;
          flavor = "balanced";
          bindings = <&mo>, <&kp>;
      };

      lmb_single: lmb_single {
          compatible = "zmk,behavior-macro";
          label = "LMB_SINGLE";
          #binding-cells = <0>;
          bindings = <&mkp MB1>;
      };

      lmb_double: lmb_double {
          compatible = "zmk,behavior-macro";
          label = "LMB_DOUBLE";
          #binding-cells = <0>;
          tap-ms = <20>;
          wait-ms = <40>;
          bindings = <&mkp MB1 &mkp MB1>;
      };

      k_click: k_click {
          compatible = "zmk,behavior-hold-tap";
          label = "K_CLICK";
          #binding-cells = <2>;
          tapping-term-ms = <150>;
          flavor = "tap-preferred";
          bindings = <&lmb_double>, <&lmb_single>;
      };

      rmb_single: rmb_single {
          compatible = "zmk,behavior-macro";
          label = "RMB_SINGLE";
          #binding-cells = <0>;
          bindings = <&mkp MB2>;
      };

      mmb_single: mmb_single {
          compatible = "zmk,behavior-macro";
          label = "MMB_SINGLE";
          #binding-cells = <0>;
          bindings = <&mkp MB3>;
      };

      o_click: o_click {
          compatible = "zmk,behavior-hold-tap";
          label = "O_CLICK";
          #binding-cells = <2>;
          tapping-term-ms = <150>;
          flavor = "tap-preferred";
          bindings = <&mmb_single>, <&rmb_single>;
      };

      mouse_cmd: mouse_cmd {
          compatible = "zmk,behavior-macro";
          label = "MOUSE_CMD";
          #binding-cells = <0>;
          wait-ms = <0>;
          bindings = <&macro_press &kp LGUI &mo 5 &macro_pause_for_release &macro_release &mo 5 &kp LGUI>;
      };

      screenshot_full_clip: screenshot_full_clip {
          compatible = "zmk,behavior-macro";
          label = "SCREENSHOT_FULL_CLIP";
          #binding-cells = <0>;
          bindings = <&kp LC(LS(LG(N3)))>;
      };

      screenshot_full_file: screenshot_full_file {
          compatible = "zmk,behavior-macro";
          label = "SCREENSHOT_FULL_FILE";
          #binding-cells = <0>;
          bindings = <&kp LS(LG(N3))>;
      };

      screenshot_portion_clip: screenshot_portion_clip {
          compatible = "zmk,behavior-macro";
          label = "SCREENSHOT_PORTION_CLIP";
          #binding-cells = <0>;
          bindings = <&kp LC(LS(LG(N4)))>;
      };

      screenshot_portion_file: screenshot_portion_file {
          compatible = "zmk,behavior-macro";
          label = "SCREENSHOT_PORTION_FILE";
          #binding-cells = <0>;
          bindings = <&kp LS(LG(N4))>;
      };

      screenshot3: screenshot3 {
          compatible = "zmk,behavior-hold-tap";
          label = "SCREENSHOT_3";
          #binding-cells = <2>;
          tapping-term-ms = <150>;
          flavor = "tap-preferred";
          bindings = <&screenshot_full_file>, <&screenshot_full_clip>;
      };

      screenshot4: screenshot4 {
          compatible = "zmk,behavior-hold-tap";
          label = "SCREENSHOT_4";
          #binding-cells = <2>;
          tapping-term-ms = <150>;
          flavor = "tap-preferred";
          bindings = <&screenshot_portion_file>, <&screenshot_portion_clip>;
      };

      c_paste_launcher: c_paste_launcher {
          compatible = "zmk,behavior-macro";
          label = "C_PASTE_LAUNCHER";
          #binding-cells = <0>;
          bindings = <&kp LA(LS(C))>;
      };

      c_copy: c_copy {
          compatible = "zmk,behavior-macro";
          label = "C_COPY";
          #binding-cells = <0>;
          bindings = <&kp C>;
      };

      c_cmd_dual: c_cmd_dual {
          compatible = "zmk,behavior-hold-tap";
          label = "C_CMD_DUAL";
          #binding-cells = <2>;
          tapping-term-ms = <150>;
          flavor = "tap-preferred";
          bindings = <&c_paste_launcher>, <&c_copy>;
      };

      c_cmd: c_cmd {
          compatible = "zmk,behavior-mod-morph";
          label = "C_CMD";
          #binding-cells = <0>;
          bindings = <&kp C>, <&c_cmd_dual 0 0>;
          mods = <(MOD_LGUI|MOD_RGUI)>;
          keep-mods = <(MOD_LGUI|MOD_RGUI)>;
      };

      v_paste_in_place: v_paste_in_place {
          compatible = "zmk,behavior-macro";
          label = "V_PASTE_IN_PLACE";
          #binding-cells = <0>;
          bindings = <&kp LA(LS(V))>;
      };

      v_paste: v_paste {
          compatible = "zmk,behavior-macro";
          label = "V_PASTE";
          #binding-cells = <0>;
          bindings = <&kp V>;
      };

      v_cmd_dual: v_cmd_dual {
          compatible = "zmk,behavior-hold-tap";
          label = "V_CMD_DUAL";
          #binding-cells = <2>;
          tapping-term-ms = <150>;
          flavor = "tap-preferred";
          bindings = <&v_paste_in_place>, <&v_paste>;
      };

      v_cmd: v_cmd {
          compatible = "zmk,behavior-mod-morph";
          label = "V_CMD";
          #binding-cells = <0>;
          bindings = <&kp V>, <&v_cmd_dual 0 0>;
          mods = <(MOD_LGUI|MOD_RGUI)>;
          keep-mods = <(MOD_LGUI|MOD_RGUI)>;
      };

      seek_caps: seek_caps {
          compatible = "zmk,behavior-macro";
          label = "SEEK_CAPS";
          #binding-cells = <0>;
          bindings = <&kp CAPS>;
      };

      cmd_opt_enter_tap: cmd_opt_enter_tap {
          compatible = "zmk,behavior-macro";
          label = "CMD_OPT_ENTER_TAP";
          #binding-cells = <0>;
          bindings = <&kp LG(LA(ENTER))>;
      };

      seek_enter: seek_enter {
          compatible = "zmk,behavior-hold-tap";
          label = "SEEK_ENTER";
          #binding-cells = <2>;
          tapping-term-ms = <150>;
          flavor = "tap-preferred";
          bindings = <&seek_caps>, <&cmd_opt_enter_tap>;
      };

      gui_soft_enter: gui_soft_enter {
          compatible = "zmk,behavior-macro";
          label = "GUI_SOFT_ENTER";
          #binding-cells = <0>;
          bindings = <&kp LG(LS(ENTER))>;
      };

      gui_normal_enter: gui_normal_enter {
          compatible = "zmk,behavior-macro";
          label = "GUI_NORMAL_ENTER";
          #binding-cells = <0>;
          bindings = <&kp LG(ENTER)>;
      };

      gui_enter_soft: gui_enter_soft {
          compatible = "zmk,behavior-hold-tap";
          label = "GUI_ENTER_SOFT";
          #binding-cells = <2>;
          tapping-term-ms = <150>;
          flavor = "tap-preferred";
          bindings = <&gui_soft_enter>, <&gui_normal_enter>;
      };

      enter_alt_check: enter_alt_check {
          compatible = "zmk,behavior-mod-morph";
          label = "ENTER_ALT_CHECK";
          #binding-cells = <0>;
          bindings = <&gui_enter_soft 0 0>, <&seek_enter 0 0>;
          mods = <(MOD_LALT|MOD_RALT)>;
      };

      enter_cmd_check: enter_cmd_check {
          compatible = "zmk,behavior-mod-morph";
          label = "ENTER_CMD_CHECK";
          #binding-cells = <0>;
          bindings = <&enter_soft 0 0>, <&enter_alt_check>;
          mods = <(MOD_LGUI|MOD_RGUI)>;
      };

      fn_up_cmd: fn_up_cmd {
          compatible = "zmk,behavior-mod-morph";
          label = "FN_UP_CMD";
          #binding-cells = <0>;
          bindings = <&kp PG_UP>, <&kp HOME>;
          mods = <(MOD_LGUI|MOD_RGUI)>;
      };

      fn_down_cmd: fn_down_cmd {
          compatible = "zmk,behavior-mod-morph";
          label = "FN_DOWN_CMD";
          #binding-cells = <0>;
          bindings = <&kp PG_DN>, <&kp END>;
          mods = <(MOD_LGUI|MOD_RGUI)>;
      };

      soft_enter: soft_enter {
          compatible = "zmk,behavior-macro";
          label = "SOFT_ENTER";
          #binding-cells = <0>;
          bindings = <&kp LS(ENTER)>;
      };

      normal_enter: normal_enter {
          compatible = "zmk,behavior-macro";
          label = "NORMAL_ENTER";
          #binding-cells = <0>;
          bindings = <&kp ENTER>;
      };

      enter_soft: enter_soft {
          compatible = "zmk,behavior-hold-tap";
          label = "ENTER_SOFT";
          #binding-cells = <2>;
          tapping-term-ms = <150>;
          flavor = "tap-preferred";
          bindings = <&soft_enter>, <&normal_enter>;
      };
    };

  keymap {
    compatible = "zmk,keymap";

    default_layer {
      display-name = "Base";
      bindings = <
        &kp EQUAL &kp N1    &kp N2   &kp N3   &kp N4     &kp N5 &tog 1                                                           &mo 3 &kp N6 &kp N7 &kp N8    &kp N9   &kp N0   &kp MINUS
        &kp TAB   &kp Q     &kp W    &kp E    &kp R      &kp T  &none                                                            &screenshot3 0 0 &kp Y  &kp U  &kp I     &kp O    &kp P    &kp BSLH
        &kp ESC   &kp A     &kp S    &kp D    &f_mouse 4 F &kp G  &none           &kp HOME &kp END &kp LGUI &kp DEL               &screenshot4 0 0 &kp H  &kp J  &kp K     &kp L    &kp SEMI &kp SQT
        &kp LSHFT &kp Z     &kp X    &c_cmd   &v_cmd     &kp B                            &kp LCTRL &kp PG_UP                         &kp N  &kp M  &kp COMMA &kp DOT  &kp FSLH &kp RSHFT
        &mo 2     &kp GRAVE &none &kp LEFT &kp RIGHT                &kp SPACE &kp LGUI &kp LALT &kp PG_DN &kp BSPC &enter_cmd_check             &kp UP &kp DOWN  &kp LBKT &kp RBKT &mo 2
      >;
    };
    keypad {
      display-name = "Keypad";
      bindings = <
        &kp EQUAL &kp N1    &kp N2   &kp N3   &kp N4     &kp N5 &trans                                                           &mo 3 &kp N6 &kp KP_NUM &kp KP_EQUAL &kp KP_DIVIDE &kp KP_MULTIPLY &kp MINUS
        &kp TAB   &kp Q     &kp W    &kp E    &kp R      &kp T  &none                                                            &none &kp Y  &kp KP_N7  &kp KP_N8    &kp KP_N9     &kp KP_MINUS    &kp BSLH
        &kp ESC   &kp A     &kp S    &kp D    &kp F      &kp G  &none           &kp LCTRL &kp LALT &kp LGUI  &kp RCTRL           &none &kp H  &kp KP_N4  &kp KP_N5    &kp KP_N6     &kp KP_PLUS     &kp SQT
        &kp LSHFT &kp Z     &kp X    &kp C    &kp V      &kp B                            &kp HOME &kp PG_UP                           &kp N  &kp KP_N1  &kp KP_N2    &kp KP_N3     &kp KP_ENTER    &kp RSHFT
        &mo 2     &kp GRAVE &none &kp LEFT &kp RIGHT                &kp BSPC &kp DEL   &kp END  &kp PG_DN &kp ENTER &kp KP_N0              &kp UP     &kp DOWN     &kp KP_DOT    &kp RBKT        &mo 2
      >;
    };
    fn {
      display-name = "Fn";
      bindings = <
        &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6 &tog 1                                           &mo 3 &kp F7 &kp F8 &kp F9 &kp F10 &kp F11 &kp F12
        &trans &trans &trans &trans &trans &trans  &none                                           &none &trans &trans &trans &trans  &trans  &trans
        &trans &trans &trans &trans &trans &trans  &none        &trans &trans &trans &trans        &none &trans &trans &trans &trans  &trans  &trans
        &trans &trans &trans &trans &trans &trans                      &trans &trans                     &trans &trans &trans &trans  &trans &trans
        &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans &trans              &fn_up_cmd &fn_down_cmd &trans  &trans  &trans
      >;
    };
    mod {
      display-name = "Mod";
      bindings = <
        &none &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &none                                                                     &trans                 &none        &none        &none        &none &none &none
        &none &none        &none        &none        &none        &none        &bootloader                                                               &bootloader            &none        &none        &none        &none &none &none
        &studio_unlock &none        &none        &none        &none        &none        &none                   &none &none &bt BT_CLR &none                      &stp STP_BAT &none        &none        &none        &none &none &none
        &none &none        &none        &none        &macro_ver   &none                                      &none &none                                                        &none        &none        &none        &none &none &none
        &none &none        &none        &none        &none                                       &none &none &none &none      &bl BL_TOG &rgb_ug RGB_TOG                                     &bl BL_INC   &bl BL_DEC   &none &none &none
      >;
    };
    extra1 {
      display-name = "Red";
      bindings = <
        &trans &trans &trans &trans &trans &trans &trans                                      &mo 3  &trans &trans &trans &trans &trans &trans
        &trans &trans &trans &trans &trans &trans &trans                                      &trans &msc SCRL_UP &k_click 0 0 &mmv MOVE(0,-1800) &o_click 0 0 &trans &trans
        &trans &trans &trans &trans &trans &trans &trans           &trans &trans &mouse_cmd &trans               &trans &msc SCRL_DOWN &mmv MOVE(-1800,0) &mmv MOVE(0,1800) &mmv MOVE(1800,0) &trans &trans
        &trans &trans &trans &trans &trans &trans                                             &trans &trans                    &trans &trans &kp UP &kp RIGHT &trans &trans
        &trans &trans &trans &trans &trans                                      &trans &mouse_cmd &trans &trans &trans &trans              &kp LEFT &kp DOWN &trans &trans &trans
      >;
    };

    extra2 {
      display-name = "MouseCmd";
      bindings = <
        &trans &trans &trans &trans &trans &trans &trans                                      &trans &trans &trans &trans &trans &trans &trans
        &trans &trans &trans &trans &trans &trans &trans                                      &trans &msc SCRL_LEFT &trans &trans &trans &trans &trans
        &trans &trans &trans &trans &trans &trans &trans           &trans &trans &trans &trans               &trans &msc SCRL_RIGHT &trans &trans &trans &trans &trans &trans
        &trans &trans &trans &trans &trans &trans                                             &trans &trans                    &trans &trans &trans &trans &trans &trans
        &trans &trans &trans &trans &trans                                      &trans &trans &trans &trans &trans &trans              &trans &trans &trans &trans &trans
      >;
    };
  };
};
